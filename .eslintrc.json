{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react-hooks",
    "jsdoc"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error",
    "no-constant-condition": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "jsdoc/require-jsdoc": [
      "error",
      {
        "publicOnly": true,
        "require": {
          "FunctionDeclaration": true,
          "MethodDefinition": true,
          "ClassDeclaration": true,
          "ArrowFunctionExpression": true,
          "FunctionExpression": true
        },
        "contexts": [
          "ExportNamedDeclaration > VariableDeclaration > VariableDeclarator > ArrowFunctionExpression",
          "ExportNamedDeclaration > FunctionDeclaration"
        ]
      }
    ],
    "jsdoc/require-param": "error",
    "jsdoc/require-returns": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "execa",
            "message": "Use src/executor.js for all gh CLI calls to ensure consistent error handling and redacting."
          },
          {
            "name": "ink",
            "importNames": [
              "useInput"
            ],
            "message": "Import useInput from src/hooks/useSafeInput.js so handler errors are contained (#490)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/executor.js",
        "src/executor/**/*.js",
        "src/services/**/*.js",
        "src/bootstrap.js",
        "src/**/*.test.js",
        "build.js",
        "bin/*.js",
        "src/hooks/useSafeInput.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/features/**/*.js",
        "src/components/**/*.js",
        "src/ui/**/*.js"
      ],
      "excludedFiles": [
        "**/*.test.js",
        "**/*.test.jsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "execa",
                "message": "Do not spawn processes from UI code: use src/services/platform.js or src/services/git.js so tests can mock them (#470, #489)."
              },
              {
                "name": "child_process",
                "message": "Do not spawn processes from UI code: use src/services/platform.js or src/services/git.js so tests can mock them (#470, #489)."
              },
              {
                "name": "node:child_process",
                "message": "Do not spawn processes from UI code: use src/services/platform.js or src/services/git.js so tests can mock them (#470, #489)."
              },
              {
                "name": "ink",
                "importNames": [
                  "useInput"
                ],
                "message": "Import useInput from src/hooks/useSafeInput.js so handler errors are contained (#490)."
              }
            ]
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ImportExpression[source.value=/^(execa|child_process|node:child_process)$/]",
            "message": "Do not spawn processes from UI code: use src/services/platform.js or src/services/git.js so tests can mock them (#470, #489)."
          },
          {
            "selector": "CallExpression[callee.name='require'][arguments.0.value=/^(execa|child_process|node:child_process)$/]",
            "message": "Do not spawn processes from UI code: use src/services/platform.js or src/services/git.js so tests can mock them (#470, #489)."
          },
          {
            "selector": "ImportDeclaration[source.value=/(^|\\/)theme(\\.js)?$/] > ImportSpecifier[imported.name='t']",
            "message": "Use the useTheme() hook, never the static `t` constant, in UI code (AGENTS.md invariant 7)."
          }
        ]
      }
    }
  ]
}
